# === Telegram ===
# Получить у @BotFather в Telegram: /newbot -> токен бота
TELEGRAM_BOT_TOKEN=

# === Supabase ===
# Создать проект на supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role (СЕКРЕТНЫЙ, только на сервере)
SUPABASE_SERVICE_ROLE_KEY=

# === Распознавание речи (ASR) ===
# Groq даёт бесплатный Whisper API с щедрым лимитом — проще всего начать с него
# console.groq.com -> API Keys
GROQ_API_KEY=

# === Модель для сверки текста (опционально, если решите доверить сверку LLM,
# а не чистому алгоритму) ===
# openrouter.ai -> Keys
OPENROUTER_API_KEY=
